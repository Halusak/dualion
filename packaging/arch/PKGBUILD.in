# Maintainer: Haluška <https://github.com/Halusak>
# Generated by the release workflow from packaging/arch/PKGBUILD.in.
# Install: makepkg -si   (in the folder with this file)
pkgname=dualion-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Fast dual-pane file manager"
arch=('x86_64')
url="https://github.com/Halusak/dualion"
license=('GPL-3.0-only')
depends=('webkit2gtk-4.1' 'gtk3' 'openssl' 'xdg-utils')
optdepends=(
  'udisks2: mounting disk images'
  'gvfs-smb: connecting SMB network shares'
  'smbclient: listing shared folders on the network'
  'avahi: finding computers on the network'
  'android-tools: Android devices (ADB)'
  'rclone: cloud storage through rclone'
  'docker: files in containers'
)
provides=('dualion')
conflicts=('dualion')
options=('!strip' '!debug')
source=("https://github.com/Halusak/dualion/releases/download/v${pkgver}/@DEB@")
sha256sums=('@SHA256@')

package() {
  # The .deb was unpacked by makepkg; its data archive holds /usr.
  bsdtar -xf data.tar.* -C "$pkgdir"
}
