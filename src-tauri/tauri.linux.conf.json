{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dualion",
        "width": 1320,
        "height": 820,
        "minWidth": 780,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "transparent": false,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "targets": ["deb", "appimage"],
    "linux": {
      "deb": {
        "section": "utils",
        "depends": [],
        "recommends": ["xdg-utils", "udisks2", "gvfs", "smbclient", "avahi-utils"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
